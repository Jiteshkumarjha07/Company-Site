# SMTP credentials used by /api/delete-account to send deletion requests
# to alumnest.pvt@gmail.com via Gmail.
#
# SMTP_USER: the Gmail address that sends the mail (can be alumnest.pvt@gmail.com itself)
# SMTP_APP_PASSWORD: a Gmail App Password (NOT the normal account password).
#   Create one at https://myaccount.google.com/apppasswords (requires 2-Step Verification).
SMTP_USER=alumnest.pvt@gmail.com
SMTP_APP_PASSWORD=your-16-char-app-password
